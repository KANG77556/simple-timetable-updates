<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/memo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/memo_widget_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="고정 메모"
        android:textColor="#8FC7FF"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/memo_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="고정된 메모가 없습니다."
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/memo_widget_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:text=""
        android:textColor="#C5D1DF"
        android:textSize="13sp"
        android:maxLines="5"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/memo_widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8EA0B4"
        android:textSize="11sp" />
</LinearLayout>