<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/next_widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="다음 수업"
        android:textColor="#8FC7FF"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/next_widget_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="수업 없음"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="20sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/next_widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#B9C9DD"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/next_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8FC7FF"
        android:textStyle="bold"
        android:textSize="13sp" />
</LinearLayout>