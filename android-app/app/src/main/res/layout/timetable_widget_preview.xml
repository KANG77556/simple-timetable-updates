<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 시간표"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9월 30일 수요일"
                android:textColor="#9FB0C4"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#8FC7FF"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="11dp"
        android:orientation="vertical"
        android:background="@drawable/widget_card_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="다음 1교시 · 회실 · 3학년 경영2"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="50분 후 시작 · 공용실습실"
            android:textColor="#AFC0D3"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="9dp"
        android:text="1교시  회실 · 경영2   08:55 · 공용실습실\n3교시  회실 · 경영1   10:55 · 공용실습실\n5교시  프로그래밍 · 정보   13:25 · 1-2컴퓨터실"
        android:textColor="#EAF1FA"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:maxLines="5" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="할 일 2개   일정 1개"
        android:textColor="#AFC0D3"
        android:textSize="11sp"
        android:maxLines="1" />
</LinearLayout>